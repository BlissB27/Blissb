{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "cookies",
        "cakes",
        "desserts"
      ]
    },
    "isNew": {
      "type": "boolean",
      "default": false
    },
    "isOnOffer": {
      "type": "boolean",
      "default": false
    },
    "originalPrice": {
      "type": "decimal",
      "required": true
    },
    "flavors": {
      "type": "json"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "stock": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "allowCustomMessage": {
      "type": "boolean",
      "default": false
    },
    "isSoldInBox": {
      "type": "boolean",
      "default": false
    },
    "boxSize": {
      "type": "integer",
      "min": 1
    },
    "flavorOptions": {
      "type": "component",
      "component": "flavor.flavor-option",
      "repeatable": true
    }
  }
}
